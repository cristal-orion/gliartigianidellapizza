# ===== Variabili d'ambiente — Gli Artigiani =====
# Su Coolify: impostale nella sezione "Environment Variables" del servizio.
# In locale: copia questo file in `.env` e compila i valori.

# --- Accesso pannello gestore (/admin) ---
# Password con cui il titolare accede al pannello.
ADMIN_PASSWORD=cambia-questa-password

# Segreto per firmare i cookie di sessione. Usa una stringa lunga e casuale.
# Generala con:  openssl rand -hex 32
SESSION_SECRET=metti-qui-una-stringa-casuale-lunga

# --- Email (Resend) ---
# API key dal pannello Resend (https://resend.com).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Mittente verificato su Resend (il dominio deve essere verificato).
MAIL_FROM=Gli Artigiani <prenotazioni@gliartigiani.it>

# Indirizzo che riceve le notifiche di nuova prenotazione (il gestore).
MANAGER_EMAIL=info@gliartigiani.it

# --- Base URL (per i link nelle email) ---
SITE_URL=https://gliartigiani.it

# --- Klaviyo (opzionale: sync clienti con consenso marketing) ---
# Senza queste, l'export CSV funziona comunque; il sync API resta disattivato.
# Private API key (pk_...) dalle impostazioni Klaviyo.
KLAVIYO_API_KEY=
# ID della lista Klaviyo a cui iscrivere i clienti.
KLAVIYO_LIST_ID=

# --- Percorsi dati (già impostati nel Dockerfile, di norma non toccare) ---
# Vanno su un volume persistente montato su /data in Coolify.
# DATABASE_PATH=/data/artigiani.db
# UPLOAD_DIR=/data/uploads

# --- Server (impostati dal Dockerfile) ---
# HOST=0.0.0.0
# PORT=4321
