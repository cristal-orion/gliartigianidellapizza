---
interface Props {
  title?: string;
}
const { title = 'Gli Artigiani — Forme · Estro · Sapienza' } = Astro.props;
---
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Gli Artigiani — Pizzeria di qualità artigianale. Forme, Estro, Sapienza." />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <style is:global>
    @font-face {
      font-family: 'Lupina';
      src: url('/fonts/Lupina-Regular.ttf') format('truetype');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Lupina';
      src: url('/fonts/Lupina-Italic.ttf') format('truetype');
      font-weight: 400;
      font-style: italic;
      font-display: swap;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --black: #0d0d0d;
      --red: #be3030;
      --white: #ffffff;
      --cream: #e8d5bc;
      --gray: #f0efed;
      --font-brand: 'Lupina', 'Arial Narrow', Arial, sans-serif;
      --font-body: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--black);
      color: var(--white);
      font-family: var(--font-body);
      overflow-x: hidden;
    }

    ::selection {
      background: var(--red);
      color: var(--white);
    }

    ::-webkit-scrollbar {
      width: 4px;
    }
    ::-webkit-scrollbar-track {
      background: var(--black);
    }
    ::-webkit-scrollbar-thumb {
      background: var(--red);
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
