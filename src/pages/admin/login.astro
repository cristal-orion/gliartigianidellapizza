---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { isValidSession, SESSION_COOKIE } from '../../lib/auth';

if (isValidSession(Astro.cookies.get(SESSION_COOKIE)?.value)) {
  return Astro.redirect('/admin');
}
const error = Astro.url.searchParams.has('error');
---
<Layout title="Accesso gestore — Gli Artigiani" noindex={true}>
  <main class="login">
    <form class="login__card" method="POST" action="/api/admin/login">
      <img src="/images/brand/logo-red.png" alt="Gli Artigiani" class="login__logo" />
      <h1>Area gestore</h1>
      {error && <p class="login__error">Password errata. Riprova.</p>}
      <label>
        <span>Password</span>
        <input type="password" name="password" required autofocus autocomplete="current-password" />
      </label>
      <button type="submit">Entra</button>
    </form>
  </main>
</Layout>

<style>
  .login {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 2rem;
  }
  .login__card {
    width: 100%;
    max-width: 360px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(232, 213, 188, 0.12);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    text-align: center;
  }
  .login__logo { height: 38px; margin: 0 auto; }
  .login__card h1 {
    font-family: var(--font-brand);
    text-transform: uppercase;
    font-size: 1.6rem;
    color: var(--cream);
  }
  .login__error {
    color: var(--red);
    font-size: 0.88rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 0.8rem 1rem;
    color: var(--white);
    font-size: 1rem;
  }
  input:focus { outline: none; border-color: var(--red); }
  button {
    background: var(--red);
    color: var(--white);
    border: none;
    border-radius: 100px;
    padding: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 0.25s ease;
  }
  button:hover { background: #d93a3a; }
</style>
