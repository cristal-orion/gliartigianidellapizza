---
---
<footer class="footer" id="contatti">
  <div class="footer__pattern" aria-hidden="true"></div>

  <div class="footer__inner">
    <div class="footer__brand">
      <img src="/images/brand/logo-red.png" alt="Gli Artigiani" class="footer__logo" />
      <p class="footer__tag">Forme · Estro · Sapienza</p>
    </div>

    <div class="footer__cols">
      <div class="footer__col">
        <h4>Dove siamo</h4>
        <p>
          <a href="https://maps.app.goo.gl/NzTQiGsL4oVdosgp9" target="_blank" rel="noopener">
            Via Santa Rita da Cascia, 13<br />80014 Giugliano in Campania (NA)
          </a>
        </p>
      </div>
      <div class="footer__col">
        <h4>Orari</h4>
        <p class="footer__closure" id="footerClosure" hidden></p>
        <ul class="footer__hours" id="footerHours">
          <li><span>Lunedì</span><span>19:00–00:00</span></li>
          <li class="is-closed"><span>Martedì</span><span>Chiuso</span></li>
          <li><span>Mercoledì</span><span>19:00–00:00</span></li>
          <li><span>Giovedì</span><span>19:00–00:00</span></li>
          <li><span>Venerdì</span><span>12:30–15:00 · 19:00–00:00</span></li>
          <li><span>Sabato</span><span>12:30–15:30 · 19:00–00:00</span></li>
          <li><span>Domenica</span><span>19:00–00:00</span></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4>Contatti</h4>
        <p>
          <a href="tel:+390815061549">081 506 1549</a><br />
          <a href="tel:+39334565789">334 565789</a>
        </p>
        <div class="footer__social">
          <a href="https://www.instagram.com/gli_artigiani_la_pizzeria/" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>
          <a href="https://www.facebook.com/GliArtigianipizzeria/" target="_blank" rel="noopener" aria-label="Facebook">Facebook</a>
        </div>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <span>© 2026 Gli Artigiani. Tutti i diritti riservati.</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--black);
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1.2rem, 5vw, 4rem) 2rem;
    overflow: hidden;
    border-top: 1px solid rgba(232, 213, 188, 0.1);
  }
  .footer__pattern {
    position: absolute;
    inset: 0;
    background: url('/images/brand/pattern-primary.jpg') center/auto 100% repeat-x;
    opacity: 0.06;
    pointer-events: none;
  }
  .footer__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 5vw, 5rem);
    max-width: 1200px;
    margin: 0 auto;
  }
  .footer__logo {
    height: 42px;
    margin-bottom: 1rem;
  }
  .footer__tag {
    color: var(--cream);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }
  .footer__cols {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: 2rem;
  }
  .footer__col h4 {
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    margin-bottom: 0.9rem;
  }
  .footer__col p {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    font-size: 0.92rem;
  }
  .footer__col a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .footer__col a:hover { color: var(--cream); }
  .footer__closure {
    color: var(--red);
    font-size: 0.82rem;
    line-height: 1.5;
    margin-bottom: 0.8rem;
    padding: 0.5rem 0.7rem;
    background: rgba(190, 48, 48, 0.12);
    border-radius: 8px;
  }
  .footer__hours {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .footer__hours li {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.72);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 0.4rem;
  }
  .footer__hours li span:first-child {
    color: var(--cream);
    white-space: nowrap;
  }
  .footer__hours li span:last-child {
    text-align: right;
  }
  .footer__hours li.is-closed span:last-child {
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
  }
  .footer__social {
    display: flex;
    gap: 1.2rem;
    margin-top: 1.1rem;
  }
  .footer__social a {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cream);
  }
  .footer__bottom {
    position: relative;
    max-width: 1200px;
    margin: 3rem auto 0;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
  }
  @media (max-width: 760px) {
    .footer { padding-left: clamp(1.4rem, 6vw, 4rem); padding-right: clamp(1.4rem, 6vw, 4rem); }
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer__cols {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer__bottom {
      justify-content: center;
      text-align: center;
      margin-top: 2.5rem;
    }
  }
</style>

<script>
  // Orari live dal pannello gestore (con fallback ai valori statici già renderizzati)
  const DAYS = ['Domenica', 'Lunedì', 'Martedì', 'Mercoledì', 'Giovedì', 'Venerdì', 'Sabato'];
  const order = [1, 2, 3, 4, 5, 6, 0];

  (async () => {
    try {
      const res = await fetch('/api/public/config');
      if (!res.ok) return;
      const { hours, closures } = await res.json();

      const ul = document.getElementById('footerHours');
      if (ul && hours) {
        ul.innerHTML = order.map((d) => {
          const ranges = hours[d] || [];
          if (ranges.length === 0) {
            return `<li class="is-closed"><span>${DAYS[d]}</span><span>Chiuso</span></li>`;
          }
          const txt = ranges.map((r) => `${r.open}–${r.close}`).join(' · ');
          return `<li><span>${DAYS[d]}</span><span>${txt}</span></li>`;
        }).join('');
      }

      const banner = document.getElementById('footerClosure');
      if (banner && Array.isArray(closures)) {
        const today = new Date().toISOString().slice(0, 10);
        const next = closures.filter((c) => c.date >= today).sort((a, b) => a.date.localeCompare(b.date))[0];
        if (next) {
          const d = new Date(next.date + 'T00:00:00').toLocaleDateString('it-IT', { day: 'numeric', month: 'long' });
          banner.textContent = `Chiusura straordinaria: ${d}${next.reason ? ' — ' + next.reason : ''}`;
          banner.hidden = false;
        }
      }
    } catch {
      /* in caso di errore restano gli orari statici */
    }
  })();
</script>
